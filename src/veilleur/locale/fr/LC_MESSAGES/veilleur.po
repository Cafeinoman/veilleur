#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s :"

#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s : erreur : %(message)s\n"

msgid "Administration of the Veilleur watch server."
msgstr "Administration du serveur de veille Veilleur."

#, python-brace-format
msgid "Veilleur {version}, watch server under the EUPL-1.2 licence"
msgstr "Veilleur {version}, serveur de veille sous licence EUPL-1.2"

